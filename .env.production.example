# -----------------------------------------------------------------------------
# IIG Admin — Production environment
# Copy this file to /opt/ai-scoring/.env on the server and replace every
# CHANGE_ME value. Never commit the real .env file.
# -----------------------------------------------------------------------------

# Application identity and public URL
NODE_ENV=production
APP_ENV=production
APP_VERSION=1.1.0
APP_COMMIT=
PORT=5005
APP_URL=https://admin.iigvn.site
PUBLIC_URL=https://admin.iigvn.site

# PostgreSQL
DATABASE_URL=postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@127.0.0.1:5432/CHANGE_ME_DATABASE

# Authentication — generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS

# Gmail SMTP for invitations, account activation and password reset
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=nhannguyen14.dev@gmail.com
SMTP_PASSWORD=CHANGE_ME_GOOGLE_APP_PASSWORD
SMTP_FROM=IIG Admin <nhannguyen14.dev@gmail.com>

# IIG e-learning integration
IIG_API_URL=https://elearningapi.iigvietnam.com
IIG_API_KEY=CHANGE_ME
IIG_USERNAME=CHANGE_ME
IIG_PASSWORD=CHANGE_ME

# Legacy/default Dify agent. Agents managed in the UI store their own endpoint
# and API key; leave these empty if no default agent is required.
DIFY_API_URL=https://dify.iigvn.site/v1
DIFY_API_KEY=

# Cloudflare R2 storage for audio and bank-statement source files. In production,
# bank-statement imports require all credentials below and a token scoped to this
# bucket with Object Read + Write permissions (Put/Get/Head/Delete).
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=ai-scoring-audio
R2_CLEAN_AUDIO_PREFIX=cleaned-audio
R2_GENERATED_AUDIO_PREFIX=dialogues
AUDIO_STORAGE_MODE=r2

# Local audio processing runtimes on the production server
AUDIO_CLEANER_PYTHON=python3
OPENVOICE_PYTHON=./voice_clone_env/bin/python3
OPENVOICE_MODEL_DIR=./voice_clone_models

# Only used once when the users table is empty. Leave blank on an initialized DB.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
