PORT=5005
NODE_ENV=development
APP_ENV=development
APP_VERSION=1.1.0
APP_COMMIT=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_scoring_admin
DB_POOL_MAX=30
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
JWT_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://127.0.0.1:5174

# SMTP is required for invitation and password-reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=IIG Admin <no-reply@iigvietnam.com>

# Used only when the users table is empty.
BOOTSTRAP_ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-12345

IIG_API_URL=https://elearningapi.iigvietnam.com
IIG_ADMIN_URL=https://elearning-admin.iigvn.com
# Cookie header copied from an authenticated elearning-admin session.
# Keep this value server-side and quote it when it contains spaces or semicolons.
IIG_ADMIN_SESSION_COOKIE=
IIG_ADMIN_REQUEST_TIMEOUT_MS=120000

# External API used by IIG eLearning to enqueue asynchronous scoring ingestion.
# Use at least 32 random characters and keep the production value in deployment secrets.
IIG_SCORING_INGESTION_API_KEY=
IIG_SCORING_INGESTION_IP_ALLOWLIST=
IIG_SCORING_INGESTION_RATE_LIMIT_PER_MINUTE=120
IIG_INGESTION_SOURCE_WORKER_ENABLED=false
IIG_INGESTION_SOURCE_POLL_MS=1000
IIG_INGESTION_SOURCE_STALE_MS=300000
IIG_INGESTION_SOURCE_MAX_ATTEMPTS=5
IIG_INGESTION_SOURCE_SNAPSHOT_DAYS=7
IIG_INGESTION_SYNC_WORKER_ENABLED=false
IIG_INGESTION_SYNC_POLL_MS=1000
IIG_INGESTION_SYNC_STALE_MS=300000
IIG_INGESTION_SYNC_MAX_ATTEMPTS=5
IIG_INGESTION_MEDIA_WORKER_ENABLED=false
IIG_INGESTION_MEDIA_POLL_MS=1000
IIG_INGESTION_MEDIA_STALE_MS=900000
IIG_INGESTION_MEDIA_MAX_ATTEMPTS=5
# Safe default for a 4-vCPU / 8-GB worker. Values above 4 are clamped.
IIG_INGESTION_MEDIA_CONCURRENCY=2
IIG_INGESTION_QUESTION_STT_WORKER_ENABLED=false
IIG_INGESTION_QUESTION_STT_CONCURRENCY=2
IIG_INGESTION_QUESTION_STT_MAX_ATTEMPTS=5
# auto-selects Gemini when GEMINI_QUESTION_STT_API_KEY exists; otherwise uses Dify.
IIG_QUESTION_STT_PROVIDER=
IIG_QUESTION_STT_DIFY_FALLBACK=true
GEMINI_QUESTION_STT_API_KEY=
GEMINI_QUESTION_STT_MODEL=gemini-3.8-flash
GEMINI_QUESTION_STT_TIMEOUT_MS=120000
GEMINI_QUESTION_STT_MAX_OUTPUT_TOKENS=1024
GEMINI_QUESTION_STT_THINKING_BUDGET=0
IIG_MEDIA_ALLOWED_HOSTS=elearningapi.iigvietnam.com,els3.iigvietnam.com,han02.vstorage.vngcloud.vn
IIG_AUDIO_CLEANING_METHOD=ai
IIG_INGESTION_VALIDATION_WORKER_ENABLED=false
IIG_INGESTION_VALIDATION_POLL_MS=1000
IIG_INGESTION_VALIDATION_STALE_MS=300000
IIG_INGESTION_VALIDATION_MAX_ATTEMPTS=5
AI_SCORING_WEBHOOK_WORKER_ENABLED=false
IIG_AI_RUN_CREATION_WORKER_ENABLED=false

# New AI scoring pipeline. Its workers remain off by default and should be
# enabled only after the target environment has its Dify and storage secrets.
IIG_AI_ORCHESTRATOR_WORKER_ENABLED=false
IIG_AI_ORCHESTRATOR_POLL_MS=1000
IIG_AI_ORCHESTRATOR_STALE_MS=300000
IIG_AI_ORCHESTRATOR_MAX_ATTEMPTS=5
IIG_AI_ANSWER_STT_WORKER_ENABLED=false
IIG_AI_ANSWER_STT_POLL_MS=1000
IIG_AI_ANSWER_STT_STALE_MS=300000
IIG_AI_ANSWER_STT_MAX_ATTEMPTS=5
IIG_AI_ANSWER_STT_CONCURRENCY=11
IIG_AI_ANSWER_STT_DIFY_ENDPOINT=https://your-dify-host.example/v1
IIG_AI_ANSWER_STT_DIFY_API_KEY=
IIG_AI_ANSWER_STT_TIMEOUT_MS=120000
IIG_AI_ANSWER_STT_PROVIDER=DIFY
IIG_AI_ANSWER_STT_MODEL=gemini-3.8-flash
IIG_AI_ANSWER_STT_MODEL_VERSION=gemini-3.8-flash
IIG_AI_ANSWER_STT_PROMPT_VERSION=answer-stt-v1
# Legacy Azure RTA settings. The active Q1-Q2 path uses Dify for STT and scoring;
# keep the Azure evidence worker disabled unless running an explicit comparison.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
IIG_AI_RTA_AZURE_TIMEOUT_MS=120000
IIG_AI_RTA_AZURE_MODEL=pronunciation-assessment
IIG_AI_RTA_AZURE_MODEL_VERSION=1.52.0
IIG_AI_RTA_AZURE_CONFIG_VERSION=rta-scripted-continuous-v1
IIG_AI_FEATURE_WORKER_ENABLED=false
IIG_AI_FEATURE_POLL_MS=1000
IIG_AI_FEATURE_STALE_MS=300000
IIG_AI_FEATURE_MAX_ATTEMPTS=5
IIG_AI_FEATURE_CONCURRENCY=16
IIG_AI_FEATURE_VERSION=iig-ai-evidence-v2
IIG_AI_SPEECH_EVIDENCE_WORKER_ENABLED=false
IIG_AI_TASK_EVIDENCE_WORKER_ENABLED=false

# Deterministic Azure Pronunciation Assessment evidence for Read Text Aloud.
IIG_AI_RTA_EVIDENCE_WORKER_ENABLED=false
IIG_AI_RTA_EVIDENCE_CONCURRENCY=8
IIG_AI_RTA_EVIDENCE_POLL_MS=1000
IIG_AI_RTA_EVIDENCE_STALE_MS=300000
IIG_AI_RTA_EVIDENCE_MAX_ATTEMPTS=5

# RTA Q1-Q2 scoring through the dedicated Dify workflow.
IIG_AI_RTA_SCORING_WORKER_ENABLED=false
IIG_AI_RTA_SCORING_CONCURRENCY=8
IIG_AI_RTA_SCORING_POLL_MS=1000
IIG_AI_RTA_SCORING_STALE_MS=300000
IIG_AI_RTA_SCORING_MAX_ATTEMPTS=5
IIG_AI_RTA_DIFY_ENDPOINT=https://your-dify-host.example/v1
IIG_AI_RTA_DIFY_API_KEY=
IIG_AI_RTA_DIFY_TIMEOUT_MS=180000
IIG_AI_RTA_DIFY_MODEL=gemini-3.8-flash
IIG_AI_RTA_DIFY_MODEL_VERSION=gemini-3.8-flash
IIG_AI_RTA_DIFY_PROMPT_VERSION=rta-question-flow-v2

# Final Q1-Q2 group score through the separate lightweight Dify workflow.
IIG_AI_RTA_GROUP_SCORING_WORKER_ENABLED=false
IIG_AI_RTA_GROUP_SCORING_CONCURRENCY=4
IIG_AI_RTA_GROUP_SCORING_POLL_MS=1000
IIG_AI_RTA_GROUP_SCORING_STALE_MS=300000
IIG_AI_RTA_GROUP_SCORING_MAX_ATTEMPTS=5
IIG_AI_RTA_GROUP_DIFY_ENDPOINT=https://your-dify-host.example/v1
IIG_AI_RTA_GROUP_DIFY_API_KEY=
IIG_AI_RTA_GROUP_DIFY_TIMEOUT_MS=120000
IIG_AI_RTA_GROUP_DIFY_MODEL=gemini-3.8-flash
IIG_AI_RTA_GROUP_DIFY_MODEL_VERSION=gemini-3.8-flash
IIG_AI_RTA_GROUP_DIFY_PROMPT_VERSION=rta-group-prompt-v1

# Describe a Picture Q3-Q4 question scoring (disabled until both Dify apps are imported)
IIG_AI_DESCRIBE_PICTURE_SCORING_WORKER_ENABLED=false
IIG_AI_DESCRIBE_PICTURE_SCORING_CONCURRENCY=8
IIG_AI_DESCRIBE_PICTURE_SCORING_POLL_MS=1000
IIG_AI_DESCRIBE_PICTURE_SCORING_STALE_MS=300000
IIG_AI_DESCRIBE_PICTURE_SCORING_MAX_ATTEMPTS=5
IIG_AI_DESCRIBE_PICTURE_DIFY_ENDPOINT=https://your-dify-host.example/v1
IIG_AI_DESCRIBE_PICTURE_DIFY_API_KEY=
IIG_AI_DESCRIBE_PICTURE_DIFY_TIMEOUT_MS=180000
IIG_AI_DESCRIBE_PICTURE_DIFY_MODEL=gemini-3.8-flash
IIG_AI_DESCRIBE_PICTURE_DIFY_MODEL_VERSION=gemini-3.8-flash
IIG_AI_DESCRIBE_PICTURE_DIFY_PROMPT_VERSION=describe-picture-question-flow-v2

# Describe a Picture Q3-Q4 group scoring (disabled until Dify app is imported)
IIG_AI_DESCRIBE_PICTURE_GROUP_SCORING_WORKER_ENABLED=false
IIG_AI_DESCRIBE_PICTURE_GROUP_SCORING_CONCURRENCY=4
IIG_AI_DESCRIBE_PICTURE_GROUP_SCORING_POLL_MS=1000
IIG_AI_DESCRIBE_PICTURE_GROUP_SCORING_STALE_MS=300000
IIG_AI_DESCRIBE_PICTURE_GROUP_SCORING_MAX_ATTEMPTS=5
IIG_AI_DESCRIBE_PICTURE_GROUP_DIFY_ENDPOINT=https://your-dify-host.example/v1
IIG_AI_DESCRIBE_PICTURE_GROUP_DIFY_API_KEY=
IIG_AI_DESCRIBE_PICTURE_GROUP_DIFY_TIMEOUT_MS=120000
IIG_AI_DESCRIBE_PICTURE_GROUP_DIFY_MODEL=gemini-3.8-flash
IIG_AI_DESCRIBE_PICTURE_GROUP_DIFY_MODEL_VERSION=gemini-3.8-flash
IIG_AI_DESCRIBE_PICTURE_GROUP_DIFY_PROMPT_VERSION=describe-picture-group-prompt-v1

# Speaking Q5-Q10 progressive scoring. One worker routes Q5-Q7 and Q8-Q10 to
# separate Dify workflows while preserving a shared seven-component result.
IIG_AI_EXTENDED_SPEAKING_SCORING_WORKER_ENABLED=false
IIG_AI_EXTENDED_SPEAKING_SCORING_CONCURRENCY=8
IIG_AI_EXTENDED_SPEAKING_SCORING_POLL_MS=1000
IIG_AI_EXTENDED_SPEAKING_SCORING_STALE_MS=300000
IIG_AI_EXTENDED_SPEAKING_SCORING_MAX_ATTEMPTS=5

IIG_AI_RESPOND_QUESTIONS_DIFY_ENDPOINT=https://your-dify-host.example/v1
IIG_AI_RESPOND_QUESTIONS_DIFY_API_KEY=
IIG_AI_RESPOND_QUESTIONS_DIFY_TIMEOUT_MS=180000
IIG_AI_RESPOND_QUESTIONS_DIFY_MODEL=gemini-3.8-flash
IIG_AI_RESPOND_QUESTIONS_DIFY_MODEL_VERSION=gemini-3.8-flash
IIG_AI_RESPOND_QUESTIONS_DIFY_PROMPT_VERSION=respond-questions-question-flow-v1

IIG_AI_RESPOND_INFORMATION_DIFY_ENDPOINT=https://your-dify-host.example/v1
IIG_AI_RESPOND_INFORMATION_DIFY_API_KEY=
IIG_AI_RESPOND_INFORMATION_DIFY_TIMEOUT_MS=180000
IIG_AI_RESPOND_INFORMATION_DIFY_MODEL=gemini-3.8-flash
IIG_AI_RESPOND_INFORMATION_DIFY_MODEL_VERSION=gemini-3.8-flash
IIG_AI_RESPOND_INFORMATION_DIFY_PROMPT_VERSION=respond-information-question-flow-v1

# One internal final group score after s_q5 through s_q10 are all complete.
IIG_AI_Q5_Q10_GROUP_SCORING_WORKER_ENABLED=false
IIG_AI_Q5_Q10_GROUP_SCORING_CONCURRENCY=4
IIG_AI_Q5_Q10_GROUP_SCORING_POLL_MS=1000
IIG_AI_Q5_Q10_GROUP_SCORING_STALE_MS=300000
IIG_AI_Q5_Q10_GROUP_SCORING_MAX_ATTEMPTS=5
IIG_AI_Q5_Q10_GROUP_DIFY_ENDPOINT=https://your-dify-host.example/v1
IIG_AI_Q5_Q10_GROUP_DIFY_API_KEY=
IIG_AI_Q5_Q10_GROUP_DIFY_TIMEOUT_MS=120000
IIG_AI_Q5_Q10_GROUP_DIFY_MODEL=gemini-3.8-flash
IIG_AI_Q5_Q10_GROUP_DIFY_MODEL_VERSION=gemini-3.8-flash
IIG_AI_Q5_Q10_GROUP_DIFY_PROMPT_VERSION=respond-q5-q10-group-prompt-v1

# Express an Opinion Q11. The question score is already the final singleton group score.
IIG_AI_EXPRESS_OPINION_SCORING_WORKER_ENABLED=false
IIG_AI_WRITE_SENTENCE_PICTURE_SCORING_WORKER_ENABLED=false
IIG_AI_WRITE_SENTENCE_GROUP_SCORING_WORKER_ENABLED=false
IIG_AI_EXTENDED_WRITING_SCORING_WORKER_ENABLED=false
IIG_AI_EXPRESS_OPINION_SCORING_CONCURRENCY=8
IIG_AI_EXPRESS_OPINION_SCORING_POLL_MS=1000
IIG_AI_EXPRESS_OPINION_SCORING_STALE_MS=300000
IIG_AI_EXPRESS_OPINION_SCORING_MAX_ATTEMPTS=5
IIG_AI_EXPRESS_OPINION_DIFY_ENDPOINT=https://your-dify-host.example/v1
IIG_AI_EXPRESS_OPINION_DIFY_API_KEY=
IIG_AI_EXPRESS_OPINION_DIFY_TIMEOUT_MS=180000
IIG_AI_EXPRESS_OPINION_DIFY_MODEL=gemini-3.8-flash
IIG_AI_EXPRESS_OPINION_DIFY_MODEL_VERSION=gemini-3.8-flash
IIG_AI_EXPRESS_OPINION_DIFY_PROMPT_VERSION=express-opinion-question-flow-v3

# Only required by the legacy static Dify client. Dynamic agents store their own endpoint/key.
DIFY_API_URL=
DIFY_API_KEY=

# Content source analysis. Keep "gemini" until the Dify workflow is published.
CONTENT_ANALYSIS_PROVIDER=gemini
CONTENT_ANALYSIS_DIFY_API_URL=https://your-dify-host.example/v1
CONTENT_ANALYSIS_DIFY_API_KEY=app-your-content-analysis-key
CONTENT_ANALYSIS_DIFY_TIMEOUT_MS=120000

PUBLIC_URL=

R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=ai-scoring-audio
R2_CLEAN_AUDIO_PREFIX=cleaned-audio
R2_GENERATED_AUDIO_PREFIX=dialogues

# Optional read-only profile for canonical IIG ingestion media stored in a
# different R2 bucket/account than the application's default media bucket.
IIG_SOURCE_R2_ENDPOINT=
IIG_SOURCE_R2_ACCESS_KEY=
IIG_SOURCE_R2_SECRET_KEY=
IIG_SOURCE_R2_BUCKET=iig-ai-dev
MEDIA_STORAGE_MODE=local
# Compatibility alias for older releases.
AUDIO_STORAGE_MODE=local

# Optional locally. Without Redis, exam delivery safely falls back to PostgreSQL.
REDIS_URL=
REDIS_CONNECT_TIMEOUT_MS=500
EXAM_DELIVERY_CACHE_TTL_SECONDS=21600

# Used by deploy.sh, not loaded by the Node.js application.
VPS_IP=
VPS_DIR=/opt/ai-scoring
VPS_PASSWORD=

# Local audio processing runtimes.
AUDIO_CLEANER_PYTHON=python3
# Local OpenVoice V2 voice cloning (use an isolated Python 3.9 environment)
OPENVOICE_PYTHON=./voice_clone_env/bin/python3
OPENVOICE_MODEL_DIR=./voice_clone_models
# Dify workflow dành riêng cho tính năng Gen Key Vocab (server-side only)
KEY_VOCAB_DIFY_API_URL=https://your-dify-host.example/v1
KEY_VOCAB_DIFY_API_KEY=app-your-secret-key
KEY_VOCAB_DIFY_TIMEOUT_MS=120000
DICTIONARY_DIFY_API_URL=https://your-dify-host.example/v1
DICTIONARY_EXTRACT_DIFY_API_KEY=app-your-extraction-key
DICTIONARY_ENTRY_DIFY_API_KEY=app-your-entry-key
DICTIONARY_DIFY_TIMEOUT_MS=120000
DICTIONARY_GENERATION_CONCURRENCY=6
DICTIONARY_MAX_ATTEMPTS=3
# Development only. Keep false in production; fix the Dify certificate chain instead.
DICTIONARY_ALLOW_SELF_SIGNED_CERT=false
DICTIONARY_MAX_ITEMS=300
