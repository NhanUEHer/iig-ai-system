PORT=5005
NODE_ENV=development
APP_ENV=development
APP_VERSION=1.1.0
APP_COMMIT=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_scoring_admin
DB_POOL_MAX=30
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
JWT_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://127.0.0.1:5174

# SMTP is required for invitation and password-reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=IIG Admin <no-reply@iigvietnam.com>

# Used only when the users table is empty.
BOOTSTRAP_ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-12345

IIG_API_URL=https://elearningapi.iigvietnam.com
IIG_API_KEY=
IIG_USERNAME=
IIG_PASSWORD=

# Only required by the legacy static Dify client. Dynamic agents store their own endpoint/key.
DIFY_API_URL=
DIFY_API_KEY=

# Content source analysis. Keep "gemini" until the Dify workflow is published.
CONTENT_ANALYSIS_PROVIDER=gemini
CONTENT_ANALYSIS_DIFY_API_URL=https://your-dify-host.example/v1
CONTENT_ANALYSIS_DIFY_API_KEY=app-your-content-analysis-key
CONTENT_ANALYSIS_DIFY_TIMEOUT_MS=120000

PUBLIC_URL=

R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=ai-scoring-audio
R2_CLEAN_AUDIO_PREFIX=cleaned-audio
R2_GENERATED_AUDIO_PREFIX=dialogues
MEDIA_STORAGE_MODE=local
# Compatibility alias for older releases.
AUDIO_STORAGE_MODE=local

# Optional locally. Without Redis, exam delivery safely falls back to PostgreSQL.
REDIS_URL=
REDIS_CONNECT_TIMEOUT_MS=500
EXAM_DELIVERY_CACHE_TTL_SECONDS=21600

# Used by deploy.sh, not loaded by the Node.js application.
VPS_IP=
VPS_DIR=/opt/ai-scoring
VPS_PASSWORD=

# Local audio processing runtimes.
AUDIO_CLEANER_PYTHON=python3
# Local OpenVoice V2 voice cloning (use an isolated Python 3.9 environment)
OPENVOICE_PYTHON=./voice_clone_env/bin/python3
OPENVOICE_MODEL_DIR=./voice_clone_models
# Dify workflow dành riêng cho tính năng Gen Key Vocab (server-side only)
KEY_VOCAB_DIFY_API_URL=https://your-dify-host.example/v1
KEY_VOCAB_DIFY_API_KEY=app-your-secret-key
KEY_VOCAB_DIFY_TIMEOUT_MS=120000
DICTIONARY_DIFY_API_URL=https://your-dify-host.example/v1
DICTIONARY_EXTRACT_DIFY_API_KEY=app-your-extraction-key
DICTIONARY_ENTRY_DIFY_API_KEY=app-your-entry-key
DICTIONARY_DIFY_TIMEOUT_MS=120000
DICTIONARY_GENERATION_CONCURRENCY=6
DICTIONARY_MAX_ATTEMPTS=3
# Development only. Keep false in production; fix the Dify certificate chain instead.
DICTIONARY_ALLOW_SELF_SIGNED_CERT=false
DICTIONARY_MAX_ITEMS=300
