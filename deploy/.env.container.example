# Runtime secrets are provisioned directly on the VPS as .env.container.
# Never commit the populated file.
DATABASE_URL=postgresql://CHANGE_ME@host.docker.internal:5432/CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@host.docker.internal:6380/0
JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
APP_URL=https://admin.iigvn.site
PUBLIC_URL=https://admin.iigvn.site
MEDIA_STORAGE_MODE=r2
AUDIO_STORAGE_MODE=r2
R2_ENDPOINT=CHANGE_ME
R2_ACCESS_KEY=CHANGE_ME
R2_SECRET_KEY=CHANGE_ME
R2_BUCKET=CHANGE_ME
